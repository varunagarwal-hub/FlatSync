# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon key, or the newer publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Gemini, used only by the server route that reads pasted listings.
# Server-side only: never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.8-flash (gemini-2.5-flash is closed to new API users)
GEMINI_MODEL=gemini-3.8-flash
